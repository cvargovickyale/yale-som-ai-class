# Copy to .env (same folder) and fill in. Never commit the real .env.
PORTKEY_API_KEY=your-portkey-api-key-here

# Every agent uses gpt-6-luna through Portkey (assignment rule). The model is
# fixed in code on purpose, so there is no model setting here.

# Optional: which database the MCP server uses (default: data/campus_customs_new.db).
# It refuses to use the original data/campus_customs.db.
# CAMPUS_CUSTOMS_DB=/path/to/campus_customs_new.db

# Optional: where the backend reaches the MCP server (default http://127.0.0.1:8765/mcp).
# MCP_PORT=8765
# MCP_URL=http://127.0.0.1:8765/mcp
