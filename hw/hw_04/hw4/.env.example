# Copy to .env (same folder) and fill in. Never commit the real .env.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: model routed through Portkey (default gpt-5.6-luna)
# AGENT_MODEL=gpt-5.6-luna

# Signs login tokens. Any long random string, e.g. from:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random one is made at startup (everyone is logged out on restart).
JWT_SECRET=change-me-to-a-long-random-string

# Optional: where the data pack lives (default: hw4/data)
# DATA_DIR=/path/to/data
