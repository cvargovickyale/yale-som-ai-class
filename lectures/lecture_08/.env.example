# Copy this file to .env (in this folder, the lectures/ folder, or the
# workspace root — agent.py checks all three) and fill in real values.
# Never commit the real .env.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional override; defaults to https://api.portkey.ai/v1 if unset.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Signs the login session tokens (JWT). Falls back to an insecure dev value
# if unset — set a real random secret before deploying anywhere.
JWT_SECRET=change-me-to-a-long-random-string
